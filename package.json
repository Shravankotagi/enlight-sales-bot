{
  "name": "enlight-sales-bot",
  "version": "1.0.0",
  "description": "Enlight Metals WhatsApp Sales Bot",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "predev": "node -e \"if (!require('fs').existsSync('./node_modules/express')) { console.log('Dependencies missing. Installing...'); require('child_process').execSync('npm install', { stdio: 'inherit' }); }\"",
    "dev": "node --watch index.js",
    "dev:nodemon": "nodemon index.js",
    "test": "node --require ./test/setup.js --test --test-reporter=spec \"src/**/*.test.js\" \"test/**/*.test.js\"",
    "chat": "node scripts/chat_cli.js",
    "test:regression": "node --require ./test/setup.js --test --test-reporter=spec \"test/regression/**/*.test.js\"",
    "test:coverage": "node --require ./test/setup.js --test --test-reporter=spec --experimental-test-coverage \"src/**/*.test.js\" \"test/**/*.test.js\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "@langchain/core": "^1.2.5",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.9",
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "nodemon": "^3.0.0",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22"
  }
}
